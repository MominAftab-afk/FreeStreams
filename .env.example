# TMDB API Credentials (Get from https://www.themoviedb.org/settings/api)
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# TMDB Endpoints
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Site Settings
NEXT_PUBLIC_SITE_NAME=RoseFlix
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Monetization Controls (Toggle true in production)
NEXT_PUBLIC_ENABLE_ADS=true
NEXT_PUBLIC_POPUNDER_SCRIPT_URL=
NEXT_PUBLIC_DIRECT_LINK_URL=https://asiafilm.org/4/287bf0d63aeec5a2ec61f86a8bf8e1bd
